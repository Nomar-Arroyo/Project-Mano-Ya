# ---------------------------------------------------------------------
# Supabase (proyecto: Mano Ya)
# ---------------------------------------------------------------------
# La URL y la clave publica se leen del panel de Supabase:
#   Project Settings > Data API > Project URL / Publishable key
SUPABASE_URL=https://waxypsqomsljcljdqwra.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Clave de servicio: solo para el backend (n8n, Edge Functions, scripts).
# NUNCA debe pasar como --dart-define ni subirse a un hosting web.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Google OAuth (Google Cloud Console > APIs y servicios > Credenciales)
# ---------------------------------------------------------------------
# GOOGLE_CLIENT_ID: client id de la app web/iOS.
# GOOGLE_SERVER_CLIENT_ID: client id de tipo "web" (Android lo exige para
# generar el id_token que valida Supabase).
GOOGLE_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=

# ---------------------------------------------------------------------
# Aplicacion
# ---------------------------------------------------------------------
# URL publica de la app web (PWA). Se usa en los enlaces de los correos y en
# los botones "abrir en el navegador" de la app movil.
WEB_APP_URL=https://mano-ya.app

# ---------------------------------------------------------------------
# Solo backend: estas variables las leen scripts de despliegue y servicios
# externos. No se pasan como --dart-define ni deben incluirse en APK/web.
# ---------------------------------------------------------------------
N8N_WEBHOOK_URL=
SUPPORT_EMAIL=soporte@manoya.app
N8N_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Solo se utiliza si Ollama está desplegado en un endpoint accesible por
# Supabase Edge Functions. No uses una dirección localhost en producción.
OLLAMA_BASE_URL=
OLLAMA_MODEL=
APP_ORIGIN=

# N8N_WEBHOOK_SECRET, RESEND_API_KEY, OLLAMA_BASE_URL y cualquier service
# role key deben configurarse únicamente como secretos de servidor en
# producción. La copia local sirve para los scripts de administración.
